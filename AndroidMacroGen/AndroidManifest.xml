<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sqc.macrogen">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="宏程序生成器"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".CodeRefActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ToleranceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name=".PhotoProvider"
            android:authorities="com.sqc.macrogen.photoprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SimActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ToolFeedActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ThreadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name=".ApkProvider"
            android:authorities="com.sqc.macrogen.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
